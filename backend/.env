# --- Mongo ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=aegisgraph

# --- Google OAuth (required) ---
# From Google Cloud Console â†’ APIs & Services â†’ Credentials â†’ OAuth 2.0 Client ID (Web application).
# Add http://localhost:3000 to "Authorized JavaScript origins".
GOOGLE_OAUTH_CLIENT_ID=297251128956-eu85sffq92pk3ahiop5a78blh1a7ops5.apps.googleusercontent.com

# --- Local dev cookie flag ---
# Set to 1 so the httpOnly session cookie works over http://localhost (SameSite=Lax, Secure=false).
# Leave unset / 0 in production so cookies stay Secure + SameSite=None.
AEGIS_COOKIE_INSECURE=1

# --- CORS (required) ---
# Must exactly match the origin the frontend is served from. The frontend
# sends credentials (cookies), and browsers reject "*" whenever credentials
# are involved â€” so this can't be left as a wildcard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Neo4j (optional, app falls back to demo data when unavailable) ---
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=Dubai12345#
NEO4J_DATABASE=aegisgraph

# --- LLM (OpenAI) ---
# Get a key from https://platform.openai.com/api-keys
# If left blank, the app automatically uses its deterministic mock LLM â€”
# the rest of the pipeline (risk scoring, moderation, audit) is unaffected.
OPENAI_API_KEY=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
OPENAI_MODEL=llama-3.3-70b-versatile

# --- Optional real NLP backends (risk_engine.py) ---
# sentence-transformers + spacy are listed in requirements.txt and used
# automatically when installed (semantic-similarity signal + real NER).
# If you skip installing them (they pull in torch and are the heaviest
# deps in the project), the app transparently falls back to lexical
# keyword matching + regex â€” nothing breaks. Set these to "1" to force
# the lexical/regex fallback even if the packages ARE installed.
# AEGIS_DISABLE_EMBEDDINGS=1
# AEGIS_DISABLE_NER=1
AEGIS_ADMIN_EMAILS=deepika.ag.admin@gmail.com
