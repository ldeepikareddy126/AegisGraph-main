# --- Mongo ---
MONGO_URL=mongodb://localhost:27017
DB_NAME=aegisgraph

# --- Google OAuth (required) ---
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application).
# Add http://localhost:3000 to "Authorized JavaScript origins".
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Local dev cookie flag ---
# Set to 1 so the httpOnly session cookie works over http://localhost (SameSite=Lax, Secure=false).
# Leave unset / 0 in production so cookies stay Secure + SameSite=None.
AEGIS_COOKIE_INSECURE=1

# --- CORS (required) ---
# Must exactly match the origin the frontend is served from. The frontend
# sends credentials (cookies), and browsers reject "*" whenever credentials
# are involved — so this can't be left as a wildcard.
CORS_ORIGINS=http://localhost:3000

# --- Explicitly trusted first-party administrator accounts (verified Google email) ---
# Comma-separated exact addresses. These accounts receive the admin role at login.
# AEGIS_ADMIN_EMAILS=admin@example.com

# --- Neo4j (optional default connection; queries require a usable Neo4j graph) ---
# If these are unset, connect a per-user database through the app.
# The application does not substitute the bundled demo corpus for retrieval.
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=
# NEO4J_DATABASE=aegisgraph

# --- LLM (OpenAI) ---
# Get a key from https://platform.openai.com/api-keys
# If left blank, the app automatically uses its deterministic mock LLM —
# the rest of the pipeline (risk scoring, moderation, audit) is unaffected.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional real NLP backends (risk_engine.py) ---
# sentence-transformers + spacy are listed in requirements.txt and used
# automatically when installed (semantic-similarity signal + real NER).
# If you skip installing them (they pull in torch and are the heaviest
# deps in the project), the app transparently falls back to lexical
# keyword matching + regex — nothing breaks. Set these to "1" to force
# the lexical/regex fallback even if the packages ARE installed.
# AEGIS_DISABLE_EMBEDDINGS=1
# AEGIS_DISABLE_NER=1
